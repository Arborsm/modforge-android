<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext stays disabled platform-wide; only the loopback hosts a Vite dev
    server can run on (emulator host alias, adb reverse targets) may serve plain
    http, so the WebView dev-server override works without weakening release.
-->
<network-security-config>
	<base-config cleartextTrafficPermitted="false" />
	<domain-config cleartextTrafficPermitted="true">
		<domain includeSubdomains="false">10.0.2.2</domain>
		<domain includeSubdomains="false">127.0.0.1</domain>
		<domain includeSubdomains="false">localhost</domain>
	</domain-config>
</network-security-config>
